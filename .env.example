# run.bat이 이 파일을 복사해 .env를 만듭니다. 키는 .env에만 입력하세요.

# Gemini API 키 (무료 발급: https://aistudio.google.com/apikey)
# 비워 두면 규칙 기반 분석으로 실행됩니다.
GEMINI_API_KEY=

# 제주데이터허브 프로젝트 키 (발급: https://jejudatahub.net > 마이페이지 > 프로젝트 관리)
# 입력하면 run.bat 실행 때 data/raw에 데이터를 자동으로 내려받습니다.
JEJU_HUB_PROJECT_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8501
OPEN_BROWSER=1
